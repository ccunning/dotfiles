# alias kutil='kubectl get nodes --no-headers | awk '\''{print $1}'\'' | xargs -I {} sh -c '\''echo {}; kubectl describe node {} | grep Allocated -A 5 | grep -ve Event -ve Allocated -ve percent -ve -- ; echo '\'''
kutil() {
  for host in $(kubectl get nodes --no-headers | cut -d' ' -f1); do
    echo "$host - $(kubectl get nodes -o jsonpath='{.metadata.labels.topology\.kubernetes\.io/zone}' $host)"
    kubectl describe node "$host" | grep Allocated -A 5 | grep -ve Event -ve Allocated -ve percent -ve --
    echo
  done
}
alias nodenuke="kubectl drain --force --ignore-daemonsets --delete-emptydir-data --disable-eviction=true"
clusternuke() {
  for node in $(kubectl get nodes --no-headers | grep -i SchedulingDisabled | awk '{print $1}'); do
    kubectl drain $node --force --ignore-daemonsets --delete-emptydir-data --disable-eviction=true
  done
}
alias kdrain="kubectl drain --ignore-daemonsets --delete-emptydir-data"

